# Copy to terraform.tfvars locally; never commit the real file.
subscription_id = "00000000-0000-0000-0000-000000000000"
resource_group_name = "rg-alz-todo-lab"
location = "East US"

# Expensive resources default to false. Enable only after cost/quota review.
enable_nat = false
enable_firewall = false
enable_vms = false
enable_app_gateway = false
enable_godaddy_dns = false

sql_server_name = "tododbsrv-lab-unique-name"
sql_database_name = "TodoDB"
sql_location = "Central US"
# Provide admin username/password securely via TF_VAR_sql_admin_username / TF_VAR_sql_admin_password.
